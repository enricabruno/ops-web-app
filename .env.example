# Configurazione GraphDB
# In locale: http://localhost:7200/repositories
GRAPHDB_URL=http://localhost:7200/repositories
REPOSITORY_ID=desmos

# Configurazione Chatbot (QRAKEN)
QRAKEN_TENANT_TOKEN=qrk_...          # client key fornita da chi gestisce il server QRAKEN
QRAKEN_TTQL=desmos.ttql              # nome del grafo di conoscenza da interrogare
QRAKEN_LLM_API_KEY=sk-ant-...        # la tua chiave Anthropic (console.anthropic.com)
QRAKEN_LLM_PROVIDER=anthropic
